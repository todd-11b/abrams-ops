# Environment variable template
#
# Keep every example value empty. Populate real values only in approved local or
# deployment environment storage; never commit credentials or operational IDs.

# ───────── Client-public routing (browser-exposed, required) ─────────
# Every VITE_* value is bundled into the browser. These identifiers are public
# routing metadata, not secrets.

VITE_GHL_FENCE_PRODUCTION_PIPELINE_ID=
VITE_GHL_STAGE_JOB_CREATED=
VITE_GHL_STAGE_SCHEDULED=
VITE_GHL_STAGE_IN_INSTALL=
VITE_GHL_STAGE_JOB_COMPLETE=
VITE_GHL_TODD_CONTACT_ID=

# ───────── Server-only secrets (required; never browser-exposed) ─────────

SUPABASE_SERVICE_ROLE_KEY=
GHL_API_KEY=
GHL_WEBHOOK_SECRET=
OPERATOR_SESSION_SECRET=
# Both PINs are required, must be distinct, and must contain exactly four ASCII digits.
OPERATOR_TODD_PIN=
OPERATOR_TY_PIN=
OPERATOR_RATE_LIMIT_PEPPER=

# ───────── Server-only configuration (required) ─────────
# These values are not browser-bundled. Treat operational identifiers as
# sensitive configuration even when they are not authentication credentials.

SUPABASE_URL=
# Authorises the scheduled blocked-job sweep. Vercel sends it as a bearer token;
# without it the cron route refuses every caller.
CRON_SECRET=
GHL_LOCATION_ID=
GHL_TODD_CONTACT_ID=
GHL_STAGE_JOB_CREATED=
GHL_STAGE_JOB_COMPLETE=

# ───────── Server-only configuration (optional/defaulted) ─────────
# HighLevel SSO signs an operator in from the dashboard instead of a PIN. It is
# off unless GHL_APP_SHARED_SECRET (generated in the app's Advanced Settings →
# Auth → Shared Secret) and at least one GHL_SSO_*_USER_ID are set; the PIN
# route is unaffected and stays the way in from a phone.
# OPERATOR_SESSION_VERSION defaults to 1 when omitted. Increment it (or rotate
# OPERATOR_SESSION_SECRET) whenever PINs rotate so existing sessions are revoked.
# GHL_OUTBOUND_IP_PREFIXES is an optional comma-separated soft-logging filter.
# GHL_SALES_PIPELINE_ID overrides the consult pipeline the browser asks for, so
# a stale client cannot open opportunities elsewhere. GHL_SALES_PIPELINE_STAGE_ID
# pins the stage new consults open in; without it the pipeline's first stage is
# resolved and sent explicitly. GHL_BUSINESS_NAME names the business on drafted
# deposit invoices and defaults to Abrams Fence.

OPERATOR_SESSION_VERSION=
GHL_APP_SHARED_SECRET=
GHL_SSO_TODD_USER_ID=
GHL_SSO_TY_USER_ID=
GHL_OUTBOUND_IP_PREFIXES=
GHL_SALES_PIPELINE_ID=
GHL_SALES_PIPELINE_STAGE_ID=
GHL_BUSINESS_NAME=
